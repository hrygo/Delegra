# Multi-stage PSS-restricted container image for `delegra-gateway-proxy`
# Build from the repository root:
#   docker build -f packages/plugins/sandbox-providers/kubernetes/Dockerfile.gateway-proxy -t ghcr.io/hrygo/delegra-gateway-proxy:v0.2.0 .

FROM node:24-alpine AS builder
WORKDIR /workspace

RUN corepack enable

# Copy root package.json so Corepack resolves the repository's pinned pnpm version.
COPY package.json ./
COPY packages/plugins/sandbox-providers/kubernetes/package.json ./packages/plugins/sandbox-providers/kubernetes/package.json
COPY packages/plugins/sandbox-providers/kubernetes/src/gateway-proxy.ts \
     packages/plugins/sandbox-providers/kubernetes/src/gateway-proxy-server.ts \
     packages/plugins/sandbox-providers/kubernetes/src/gateway-proxy-main.ts \
     ./packages/plugins/sandbox-providers/kubernetes/src/

# Install the standalone sandbox-provider plugin devDependencies (excluded from
# root pnpm-workspace.yaml) and compile only the zero-dependency gateway-proxy
# entrypoints without pulling workspace SDK/shared packages into the image build.
RUN pnpm -C packages/plugins/sandbox-providers/kubernetes install --ignore-workspace --no-lockfile && \
    pnpm -C packages/plugins/sandbox-providers/kubernetes exec tsc \
      --target ES2023 \
      --module NodeNext \
      --moduleResolution NodeNext \
      --lib ES2023 \
      --types node \
      --strict \
      --skipLibCheck \
      --rootDir src \
      --outDir dist \
      src/gateway-proxy.ts \
      src/gateway-proxy-server.ts \
      src/gateway-proxy-main.ts

FROM node:24-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    PORT=8443 \
    HOST=0.0.0.0

RUN addgroup -g 1001 -S proxy && adduser -u 1001 -S proxy -G proxy

COPY --from=builder --chown=1001:1001 /workspace/packages/plugins/sandbox-providers/kubernetes/package.json ./package.json
COPY --from=builder --chown=1001:1001 /workspace/packages/plugins/sandbox-providers/kubernetes/dist ./dist

USER 1001:1001
EXPOSE 8443

ENTRYPOINT ["node", "--zero-fill-buffers", "dist/gateway-proxy-main.js"]
